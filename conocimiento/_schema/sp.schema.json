{
  "$id": "sp",
  "descripcion": "Entrada de conocimiento/{proceso}/sps.json → sps[].",
  "type": "object",
  "required": ["nombre", "estado"],
  "properties": {
    "nombre": {"type": "string", "minLength": 3},
    "estado": {"enum": ["leido", "parcial", "listado", "no_leido", "no_existe", "documentado"]},
    "tipo": {"type": "string"},
    "fuente": {"type": "string"},
    "metodos": {"type": "array", "items": {"$ref": "metodo"}},
    "llama": {"type": "array"},
    "tablas": {"type": "array", "items": {"type": "string"}}
  }
}
