{
  "$id": "proceso",
  "descripcion": "Archivo conocimiento/{proceso}/proceso.json.",
  "type": "object",
  "required": ["id", "nombre", "estado"],
  "properties": {
    "id": {"type": "string"},
    "nombre": {"type": "string"},
    "estado": {"enum": ["completo", "documentado", "parcial", "esqueleto", "pendiente"]},
    "ventanas": {"type": "array", "items": {"type": "object"}},
    "capas": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "pasos": {"type": "array"}
  }
}
