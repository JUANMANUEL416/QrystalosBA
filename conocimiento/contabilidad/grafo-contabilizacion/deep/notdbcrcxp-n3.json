        {
          "id": "idimp-iva",
          "usvgs": "IDIMP_IVA",
          "desc": "FIMPDV vigente en líneas IVA",
          "obligatorio": "si IVA"
        },
        {
          "id": "pri",
          "tabla": "PRI",
          "obligatorio": true
        }
      ],
      "llamaAnidado": [
        "SPK_NC_CONTAB_INV",
        "SPK_NC_CONTAB_CXP"
      ]
    }
  ]
