{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/sync-chat-quatec.cmd sessionStart"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/sync-chat-quatec.cmd beforeSubmitPrompt"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/sync-chat-quatec.cmd stop",
        "loop_limit": 2
      }
    ]
  }
}
