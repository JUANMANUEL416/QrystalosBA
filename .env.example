# Copie este archivo a .env y complete los valores.
# El servidor lee .env (no lo suba a git).

# OpenAI — textos del formulario (criterios / organizar) e ilustraciones de capacitación
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1

# Cursor — bot de oficina (SDK). Cree la clave en:
# https://cursor.com/dashboard/integrations
# o https://cursor.com/dashboard/api
CURSOR_API_KEY=crsr_xxxxxxxx
# Respaldo si la primera falla (401/cupo). El bot valida y usa la activa.
CURSOR_API_KEY_2=
# Bot de oficina: Composer 2.5 Fast.
# Tarifa publicada (cursor.com/docs/models): Composer 2.5 $0.50 / $2.50; Fast $3 / $15 por 1M.
CURSOR_BOT_MODEL=composer-2.5
CURSOR_BOT_MODEL_KB=composer-2.5
CURSOR_BOT_FAST=true

# Correo del dictamen — mismos nombres que DevSoporte.
# Si no hay SMTP, se usa Outlook de escritorio.
SMTP_HOST=mail.ixcolombia.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Qrystalos - B.A. <usuario@ixcolombia.com>
SMTP_CC=jose.jimenez@ixcolombia.com
SMTP_SAVE_SENT_COPY=true
IMAP_HOST=mail.ixcolombia.com
IMAP_PORT=993
IMAP_SECURE=true
