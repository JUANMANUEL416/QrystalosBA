# Carpeta de trabajo por chat (bot.json, agente.json, copia del chat): runtime
conocimiento/canales/*/sesiones/
conocimiento/chats/*/.lock

# Archivos de medición y estado local por agente (no compartir entre máquinas)
scripts/_sc*_medicion.py
